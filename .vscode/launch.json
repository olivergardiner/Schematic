{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Schematic (MSVC Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Schematic.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug",
            "environment": [
                { "name": "PATH", "value": "${env:QT_BIN_DIR};${env:PATH}" }
            ],
            "console": "internalConsole"
        },
        {
            "name": "Launch Schematic (MSVC Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/Schematic.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Release",
            "environment": [
                { "name": "PATH", "value": "${env:QT_BIN_DIR};${env:PATH}" }
            ],
            "console": "internalConsole"
        }
    ]
}
