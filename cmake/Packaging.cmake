# Both packages consume the normal install tree, including Qt deployment.
set(CPACK_PACKAGE_NAME "Schematic")
set(CPACK_PACKAGE_VENDOR "Perspective")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Presentation-quality electronic schematic drawing")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "Schematic")
set(CPACK_PACKAGE_INSTALL_REGISTRY_KEY "Schematic")
set(CPACK_PACKAGE_EXECUTABLES "Schematic" "Schematic")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}/packages")
set(CPACK_MONOLITHIC_INSTALL ON)
set(CPACK_VERBATIM_VARIABLES ON)

if(WIN32)
    if(CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
        set(_schematic_arch "arm64")
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_schematic_arch "x64")
    else()
        set(_schematic_arch "x86")
    endif()
    set(CPACK_SYSTEM_NAME "Windows-${_schematic_arch}")
    set(CPACK_GENERATOR "NSIS;ZIP")
    set(CPACK_NSIS_DISPLAY_NAME "Schematic")
    set(CPACK_NSIS_PACKAGE_NAME "Schematic ${PROJECT_VERSION}")
    set(CPACK_NSIS_MODIFY_PATH OFF)
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
    set(CPACK_NSIS_EXECUTABLES_DIRECTORY "${CMAKE_INSTALL_BINDIR}")
    set(CPACK_NSIS_INSTALLED_ICON_NAME "${CMAKE_INSTALL_BINDIR}\\Schematic.exe")
    set(CPACK_NSIS_MUI_FINISHPAGE_RUN "Schematic.exe")
    set(CPACK_NSIS_MANIFEST_DPI_AWARE ON)
else()
    # Native installer formats will be verified when those platforms are built.
    set(CPACK_SYSTEM_NAME "${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
    set(CPACK_GENERATOR "TGZ")
endif()
set(CPACK_PACKAGE_FILE_NAME "Schematic-${PROJECT_VERSION}-${CPACK_SYSTEM_NAME}")

install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION "${CMAKE_INSTALL_DATADIR}/Schematic/licenses"
        RENAME Schematic-Apache-2.0.txt)
configure_file("${PROJECT_SOURCE_DIR}/packaging/README.txt.in"
               "${CMAKE_CURRENT_BINARY_DIR}/PACKAGE-README.txt" @ONLY)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/PACKAGE-README.txt" DESTINATION . RENAME README.txt)

# Detect from the selected kit, rather than recording a machine-specific path.
get_filename_component(_schematic_qt_kit "${Qt6_DIR}/../../.." ABSOLUTE)
get_filename_component(_schematic_qt_sources "${_schematic_qt_kit}/../Src" ABSOLUTE)
set(SCHEMATIC_QT_SOURCES_DIR "${_schematic_qt_sources}" CACHE PATH "Qt sources used for bundled license texts")
foreach(_module qtbase qtsvg qtimageformats)
    if(EXISTS "${SCHEMATIC_QT_SOURCES_DIR}/${_module}/LICENSES")
        install(DIRECTORY "${SCHEMATIC_QT_SOURCES_DIR}/${_module}/LICENSES/"
                DESTINATION "${CMAKE_INSTALL_DATADIR}/Schematic/licenses/${_module}")
    else()
        message(WARNING "Qt license texts not found for ${_module}; set SCHEMATIC_QT_SOURCES_DIR before distributing packages")
    endif()
    if(EXISTS "${_schematic_qt_kit}/sbom/${_module}-${Qt6_VERSION}.spdx.json")
        install(FILES "${_schematic_qt_kit}/sbom/${_module}-${Qt6_VERSION}.spdx.json"
                DESTINATION "${CMAKE_INSTALL_DATADIR}/Schematic/licenses/qt-sbom")
    endif()
endforeach()
include(CPack)
